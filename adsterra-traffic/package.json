{
    "name": "adsterra-direct-link-tester",
    "version": "1.0.0",
    "type": "module",
    "description": "Apify Actor for controlled browser-based testing and validation of Adsterra Direct Link URLs.",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "apify": "^3.7.0",
        "playwright": "1.61.1"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "prettier": "^3.5.3",
        "vitest": "^5.0.0"
    },
    "scripts": {
        "start": "node src/main.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "test": "vitest run test/"
